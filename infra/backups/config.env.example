# Secret-store injection only. Never copy real values into the repository.
BACKUP_SOURCE_DATABASE_URL=postgresql://sample-user:SECRET_STORE_PLACEHOLDER@source-db.example.invalid/eko?sslmode=verify-full
BACKUP_REPLICATION_DATABASE_URL=postgresql://sample-replication:SECRET_STORE_PLACEHOLDER@source-db.example.invalid/eko?sslmode=verify-full
RESTORE_ADMIN_DATABASE_URL=postgresql://sample-restore:SECRET_STORE_PLACEHOLDER@restore-db.example.invalid/postgres?sslmode=verify-full
RESTORE_DATABASE_NAME=eko_restore_sample
BACKUP_SOURCE_REVISION=LEAD_PINNED_40_HEX_REVISION
BACKUP_CANDIDATE_REVISION=LEAD_PINNED_40_HEX_REVISION
BACKUP_RECIPIENTS_FILE=./secrets/backup-recipients.txt
BACKUP_IDENTITY_FILE=./secrets/backup-identity.txt
PGSSLROOTCERT=./secrets/postgres-ca.pem
BACKUP_WAL_DIRECTORY=./encrypted-wal
RESTORE_PGDATA=./isolated-restore-data
# CURRENT durable ledger, never a copy restored from the database backup.
JOURNAL_TOMBSTONE_PATH=./secrets/current-journal-destruction.log
JOURNAL_KEK=SECRET_STORE_PLACEHOLDER
JOURNAL_KEK_ID=SECRET_STORE_PLACEHOLDER
# Only neutral fixture identities; inject out of band, never report the IDs.
RESTORE_FIXTURE_ACTIVE_ACCOUNT=NEUTRAL_FIXTURE_UUID
RESTORE_FIXTURE_ACTIVE_AGENT=NEUTRAL_FIXTURE_UUID
RESTORE_FIXTURE_DELETED_ACCOUNT=NEUTRAL_FIXTURE_UUID
RESTORE_FIXTURE_DELETED_AGENT=NEUTRAL_FIXTURE_UUID
