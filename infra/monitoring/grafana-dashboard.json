      "title": "Head lag (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eko-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "eko_launch_value{metric=\"head_lag_ms\"}",
          "refId": "A"
        }
