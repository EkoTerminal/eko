{
  "groups": [
    {
      "name": "eko-launch",
      "rules": [
        {
          "alert": "LaunchMetricsUnavailable",
          "expr": "absent(up{job=\"eko-api\"}) or up{job=\"eko-api\"} == 0",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Launch metrics source unavailable",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "LaunchCheckUnavailable",
          "expr": "(eko_check_available{check!~\"backup|preflight|quote\"} == 0) and on(check,instance,job) (eko_check_active == 1)",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Required launch check unhealthy or unavailable",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "GuardMiss",
          "expr": "eko_launch_value{metric=\"post_fill_sell_failure\"} > 0",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Post-fill sell check failed; pause trading and open an incident",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "PublishedWalletOutflow",
          "expr": "eko_launch_value{metric=\"published_wallet_unexpected_outflow\"} > 0",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Large or unexpected published-wallet outflow; review indexed transfers",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "BurnUnexpectedOutflow",
          "expr": "eko_launch_value{metric=\"burn_unexpected_outflow\"} > 0",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Published wallet anomaly requires incident review",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "BurnWrongToken",
          "expr": "eko_launch_value{metric=\"burn_wrong_token\"} > 0",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Published wallet anomaly requires incident review",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "SimulationFailures",
          "expr": "eko_launch_value{metric=\"simulation_failure\"} > 0.05",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Simulation failures exceed 5 percent for five minutes",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          },
          "for": "5m"
        },
        {
          "alert": "RpcLag",
          "expr": "eko_launch_value{metric=\"head_lag_ms\"} > 5000",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "RPC head lag exceeds five seconds",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "IndexerHeadLag",
          "expr": "eko_launch_value{metric=\"head_lag_ms\"} > 600000",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Indexed head is more than ten minutes behind: data is stale and live buys are refused; check indexer_stalled and head_retry logs",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "CompleteVerdictLatency",
          "expr": "eko_launch_value{metric=\"pair_to_complete_verdict_ms\"} > 5000",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Pair to complete verdict p95 exceeds five seconds",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "StaleCommitter",
          "expr": "time() - eko_launch_value{metric=\"receipt_commit_timestamp_s\"} >= 600",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Committer missed two five-minute windows",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "DailyBurnLate",
          "expr": "eko_check_healthy{check=\"daily_burn\"} == 0 and on(check,instance,job) eko_check_active{check=\"daily_burn\"} == 1",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Daily burn unavailable or more than sixty minutes late",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "PreflightLatency",
          "expr": "eko_launch_value{metric=\"preflight_ms\"} > 150",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "Preflight p95 exceeds 150 milliseconds",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "AiBudget",
          "expr": "eko_launch_value{metric=\"ai_budget_ratio\"} >= 0.8",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "AI spend reached eighty percent of budget",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "XBudget50",
          "expr": "eko_launch_value{metric=\"x_budget_ratio\"} >= 0.5 and eko_launch_value{metric=\"x_budget_ratio\"} < 0.8",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "X spend reached fifty percent of cap",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "XBudget80",
          "expr": "eko_launch_value{metric=\"x_budget_ratio\"} >= 0.8",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "X spend reached eighty percent of cap",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "BackupFailed",
          "expr": "eko_launch_value{metric=\"backup_success\"} == 0",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "Backup failed",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "BackupUnavailable",
          "expr": "eko_measurement_available{metric=\"backup_success\"} == 0",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "Backup result missing or stale",
            "runbook_url": "docs/eko/05-GO-PLAN.md#13-incident-runbooks"
          }
        },
        {
          "alert": "LaunchLatencyMeasurementUnavailable",
          "expr": "eko_check_available{check=~\"preflight|quote\"} == 0",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "Launch latency measurement unavailable"
          }
        },
        {
          "alert": "AiBudgetUnavailable",
          "expr": "eko_measurement_available{metric=\"ai_budget_ratio\"} == 0",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "Configured AI budget measurement unavailable"
          }
        },
        {
          "alert": "XBudgetUnavailable",
          "expr": "eko_measurement_available{metric=\"x_budget_ratio\"} == 0 and on(instance,job) eko_check_active{check=\"x\"} == 1",
          "labels": {
            "severity": "3"
          },
          "annotations": {
            "summary": "Active X budget measurement unavailable"
          }
        },
        {
          "alert": "RegistryOwnershipTransferStarted",
          "expr": "(time() - eko_launch_value{metric=\"registry_ownership_started_timestamp_s\"} >= 0) and (time() - eko_launch_value{metric=\"registry_ownership_started_timestamp_s\"} < 300)",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Registry OwnershipTransferStarted observed; reconcile with approved owner action",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "RegistryOwnershipTransferred",
          "expr": "(time() - eko_launch_value{metric=\"registry_ownership_transferred_timestamp_s\"} >= 0) and (time() - eko_launch_value{metric=\"registry_ownership_transferred_timestamp_s\"} < 300)",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Registry OwnershipTransferred observed; reconcile with approved owner action",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "RegistryCommitterChanged",
          "expr": "(time() - eko_launch_value{metric=\"registry_committer_changed_timestamp_s\"} >= 0) and (time() - eko_launch_value{metric=\"registry_committer_changed_timestamp_s\"} < 300)",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Registry CommitterChanged observed; reconcile with approved owner action",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "TradingLiveChanged",
          "expr": "increase(eko_trading_live_changes_total[5m]) > 0",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Trading runtime switch changed; verify operator and intended state",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "TradingPaused",
          "expr": "eko_trading_live == 0",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Trading runtime switch is off; verify pause and incident record",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "IncidentRecorded",
          "expr": "increase(eko_incidents_total[5m]) > 0",
          "labels": {
            "severity": "1"
          },
          "annotations": {
            "summary": "Incident recorded; verify durable stop and delivery",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "ReferencePriceStale",
          "expr": "time() - eko_launch_value{metric=\"reference_price_timestamp_s\"} > 300",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Reference-price observation is older than five minutes",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "ReceiptCommitterGasLow",
          "expr": "eko_launch_value{metric=\"receipt_committer_balance_eth\"} < 0.01",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Receipt committer gas balance below 0.01 ETH",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        },
        {
          "alert": "SecurityCollectorUnavailable",
          "expr": "eko_measurement_available{metric=~\"registry_ownership_started_timestamp_s|registry_ownership_transferred_timestamp_s|registry_committer_changed_timestamp_s|reference_price_timestamp_s|receipt_committer_balance_eth|published_wallet_unexpected_outflow|burn_unexpected_outflow|burn_wrong_token\"} == 0",
          "labels": {
            "severity": "2"
          },
          "annotations": {
            "summary": "Security observation missing or stale; coverage requires its collector",
            "runbook_url": "SECURITY.md#incident-runbook"
          }
        }
      ]
    }
  ]
}
