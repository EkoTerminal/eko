{
  "route": {
    "receiver": "ops-and-oncall",
    "group_by": [
      "alertname",
      "severity"
    ],
    "group_wait": "0s",
    "group_interval": "1m",
    "repeat_interval": "1h",
    "routes": [
      {
        "matchers": [
          "severity=\"1\""
        ],
        "receiver": "ops-and-oncall"
      },
      {
        "matchers": [
          "severity=\"2\""
        ],
        "receiver": "ops-and-oncall"
      },
      {
        "matchers": [
          "severity=\"3\""
        ],
        "receiver": "ops"
      }
    ]
  },
  "receivers": [
    {
      "name": "ops",
      "webhook_configs": [
        {
          "url": "${OPS_ALERT_WEBHOOK_URL}",
          "send_resolved": true
        }
      ]
    },
    {
      "name": "ops-and-oncall",
      "webhook_configs": [
        {
          "url": "${OPS_ALERT_WEBHOOK_URL}",
          "send_resolved": true
        },
        {
          "url": "${ONCALL_ALERT_WEBHOOK_URL}",
          "send_resolved": true
        }
      ]
    }
  ]
}
