{
  "name": "@eko/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "forge build",
    "test": "node scripts/test.mjs",
    "test:fork": "forge test --match-path 'test/fork/*'",
    "coverage": "forge coverage --report summary --exclude-tests --include-libs --no-match-coverage '(script/|lib/|node_modules/@openzeppelin/contracts/utils/)'",
    "abi:export": "node scripts/export-abi.mjs",
    "mutation": "node scripts/mutate.mjs"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
