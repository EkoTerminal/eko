{
  "name": "@eko/chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "verify:chain": "tsx src/verify-cli.ts",
    "abi:pull": "tsx src/abi-pull-cli.ts",
    "fork:gateway": "tsx src/simulation/fork-gateway-cli.ts",
    "fork:check": "tsx src/simulation/fork-check-cli.ts",
    "fork:manifest": "node --import tsx src/simulation/fork-manifest-cli.ts"
  },
  "dependencies": {
    "@eko/shared": "workspace:*",
    "viem": "^2.56.9",
    "yaml": "2.9.0",
    "zod": "^4.6.5",
    "@eko/db": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "@types/node": "^26.6.3"
  }
}
