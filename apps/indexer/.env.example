APP_ROLE=indexer
# Set DATABASE_URL for Postgres, or leave unset to use the local PGlite directory.
# DATABASE_URL=postgres://demo-account:replace-me@localhost:5432/eko
PGLITE_DIR=.data/indexer
RPC_HTTP_URL=https://replace-me.invalid
# Optional; logs mode does not subscribe to newHeads.
# RPC_WS_URL=wss://replace-me.invalid
# RPC_FALLBACK_HTTP_URL=https://replace-me.invalid
# Without a head cursor, start at the current head. Set an explicit block only to override it.
# INDEX_START_BLOCK=77438503
INDEX_HEAD_MODE=logs
INDEX_HEAD_TICK_MS=1000
INDEX_HEAD_MAX_RANGE=200
INDEX_CODE_CACHE_SEC=3600
# Prefetch applies only to INDEX_HEAD_MODE=blocks.
INDEX_PREFETCH_BLOCKS=32
INDEX_BACKFILL_WORKERS=4
INDEX_LOG_RANGE=2000
INDEX_REORG_DEPTH=256

# Shared RPC spending guard. Paid endpoints above are supplied by deployment secrets.
RPC_PUBLIC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
RPC_PAID_MAX_RPM=1200
RPC_PUBLIC_MAX_RPM=300
RPC_PAID_DAILY_BUDGET=200000
# Unset means unlimited; always set a small session budget for live checks.
# RPC_SESSION_BUDGET=100
RPC_WEIGHTS={}

# Retry transient transport failures before halting; every attempt remains metered.
INDEX_TRANSIENT_RETRY_SEC=300
