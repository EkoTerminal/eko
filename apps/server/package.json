{
  "name": "@eko/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "demo:token": "node --env-file-if-exists=.env --import tsx src/http/v1/demo-token-cli.ts",
    "dev:demo": "MARKET_DATA_SOURCE=demo ENABLE_DEV_ROUTES=true PGLITE_DIR=.data/demo tsx watch --clear-screen=false src/index.ts",
    "test:fork": "vitest run --config vitest.fork.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@eko/shared": "workspace:*",
    "@eko/policy": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "viem": "^2.56.9",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "@eko/chain": "workspace:*",
    "@eko/db": "workspace:*",
    "@eko/engines": "workspace:*",
    "@eko/indexer": "workspace:*",
    "@eko/untrusted": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
